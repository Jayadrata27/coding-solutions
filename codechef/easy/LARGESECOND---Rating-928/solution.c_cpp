#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int a[n];
        for(int i=0;i<n;i++){
            cin>>a[i];
        }
        // your code goes here
        int largest=a[0];
        for(int i=1;i<n;i++){
            if(a[i]>largest){
                largest=a[i];
            }
        }
        int secondLargest=-1;
        for(int i=0;i<n;i++){
            if(a[i]==largest){
                continue;
            }
            if(a[i]>secondLargest){
                secondLargest=a[i];
            }
        }
        cout<<largest + secondLargest<<"\n";
    }
}
