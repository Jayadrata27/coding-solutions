#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	   int N;
       cin>>N;
       int arr[N];
    
        for(int i=0;i<N;i++){
            cin>>arr[i];
         }
    
         int max=arr[0];
    
        for(int i=0;i<N;i++){
            if(arr[i]>max){
                 max=arr[i];  
               }
            }
            cout<<max;
	       }
	
         return 0;
}
